# Model API key. Not needed with AGENCY_DEMO=1.
ANTHROPIC_API_KEY=

# Models (required): agents share one; the fact extractor uses a smaller, cheaper one.
AGENCY_MODEL=
AGENCY_EFFORT=high
EXTRACTOR_MODEL=
EXTRACTOR_EFFORT=low
# Retry on a fallback model if the main model declines a request (only for models that support it).
USE_REFUSAL_FALLBACKS=false

# Storage: redis+postgres (docker compose up) or memory (no services; lost on restart).
AGENCY_STORAGE=redis+postgres
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://agency:agency@localhost:5432/agency
SESSION_TTL_SECONDS=604800

# Fact confidence bands: >= auto-save is stored active, >= review waits for a person, below is dropped.
FACT_AUTO_SAVE_THRESHOLD=0.85
FACT_REVIEW_THRESHOLD=0.60
# Optional: cap facts worded by agents so a person confirms each once (e.g. 0.8).
APPROVED_OUTPUT_CONFIDENCE_CAP=

# Where the pipeline pauses for a person. "final" is always on. Add "creative" to review
# messaging and identity before the report is written.
AGENCY_CHECKPOINTS=research,strategy,final
MAX_QA_REVISIONS=2

# "A run needs you" alerts, e.g. a Slack incoming webhook.
NOTIFY_WEBHOOK_URL=
PUBLIC_BASE_URL=http://localhost:8000

# Canned outputs instead of the model API, to try the console for free.
AGENCY_DEMO=0
LOG_LEVEL=INFO
